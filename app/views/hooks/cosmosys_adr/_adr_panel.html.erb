<% supersedes = issue.adr_supersedes if issue.adr_supersedes&.visible? %>
<% successor = issue.cosmosys_adr_superseded_by %>
<% successor = nil unless successor&.visible? %>
<% status_key = issue.cosmosys_adr_status_key %>
<% setting = CosmosysAdr::ProjectSetting.for(issue.project) %>
<% allowed = issue.new_statuses_allowed_to(User.current).filter_map { |status| CosmosysAdr.status_key(status) } %>
<% entries = CosmosysAdr::Links.for_adr(issue, User.current) %>
<%# The banners use t, not l: with a key ending in _html it escapes what it
    interpolates unless it is already safe, and marks the result safe. %>
<hr />
<div class="cosmosys-adr-panel" id="cosmosys-adr-panel">
  <% if status_key == :superseded && successor %>
    <div class="flash warning cosmosys-adr-banner"><%= t(:text_cosmosys_adr_superseded_banner_html, link: cosmosys_adr_link(successor)) %></div>
  <% elsif supersedes && status_key == :proposed %>
    <div class="flash info cosmosys-adr-banner"><%= t(:text_cosmosys_adr_will_supersede_html, link: cosmosys_adr_link(supersedes)) %></div>
  <% elsif supersedes %>
    <div class="flash info cosmosys-adr-banner"><%= t(:text_cosmosys_adr_supersedes_banner_html, link: cosmosys_adr_link(supersedes)) %></div>
  <% end %>

  <div class="cosmosys-adr-actions">
    <% if issue.editable?(User.current) %>
      <% if status_key == :proposed %>
        <% if allowed.include?(:accepted) %><%= cosmosys_adr_transition_button(issue, 'accept', 'cosmosys-adr-button-primary') %><% end %>
        <% if allowed.include?(:rejected) %><%= cosmosys_adr_transition_button(issue, 'reject', 'cosmosys-adr-button-danger') %><% end %>
      <% elsif status_key == :accepted %>
        <% if allowed.include?(:deprecated) %><%= cosmosys_adr_transition_button(issue, 'deprecate', '') %><% end %>
      <% end %>
    <% end %>
    <% if status_key == :accepted && CosmosysAdr.adr_creatable?(issue.project, User.current) %>
      <%= link_to l(:label_cosmosys_adr_supersede), new_project_issue_path(issue.project, issue: { tracker_id: issue.tracker_id, adr_supersedes_id: issue.id }), class: 'cosmosys-adr-button' %>
    <% end %>
    <% decisions = status_key == :proposed ? %i[accepted rejected] : (status_key == :accepted ? %i[deprecated] : []) %>
    <% if decisions.any? && (decisions & allowed).empty? %>
      <span class="cosmosys-adr-hint"><%= l(:text_cosmosys_adr_cannot_decide, roles: cosmosys_adr_role_names(setting)) %></span>
    <% end %>
  </div>

  <p class="cosmosys-adr-section-title"><strong><%= l(:label_cosmosys_adr_linked_issues) %></strong></p>
  <% if entries.any? %>
    <table class="list cosmosys-adr-links">
      <thead><tr><th><%= l(:label_project) %></th><th><%= l(:label_issue) %></th><th><%= l(:field_status) %></th><th><%= l(:label_cosmosys_adr_origin) %></th></tr></thead>
      <tbody>
        <% entries.each do |entry| %>
          <tr class="<%= cycle('odd', 'even') %>">
            <td><%= link_to_project(entry.issue.project) %></td>
            <td class="subject"><%= link_to_issue(entry.issue) %></td>
            <td><%= entry.issue.status %></td>
            <td><%= cosmosys_adr_origin_label(entry) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="nodata"><%= l(:text_cosmosys_adr_no_linked_issues) %></p>
  <% end %>
</div>
